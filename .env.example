# Gmail SMTP (for notification-service - order confirmation emails)
# Get a 16-char app password from Google Account > Security > 2FA > App passwords
MAIL_USERNAME=you@gmail.com
MAIL_PASSWORD=your-16-char-app-password-no-spaces
MAIL_FROM=you@gmail.com

# OpenTelemetry HTTP endpoint (used inside docker-compose)
OTEL_EXPORTER_OTLP_ENDPOINT=http://shipwise-lgtm:4318/v1

# Fallback mail host/port if not using real Gmail
MAIL_HOST=localhost
MAIL_PORT=1025